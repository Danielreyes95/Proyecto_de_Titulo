# Copiar a .env y completar localmente. NO ingresar secretos reales en GitHub.
PORT=3000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Administración global (secreto separado de JWT_SECRET)
PLATFORM_JWT_SECRET=
# Solo durante bootstrap; retirar después de crear la cuenta
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
